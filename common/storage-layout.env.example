# Copie este archivo únicamente cuando el equipo de infraestructura entregue
# mount points administrados por el cliente.
#
# cp common/storage-layout.env.example /root/instana-install/storage-layout.env
# vi /root/instana-install/storage-layout.env
#
# No incluya credenciales.

STANCTL_CLUSTER_DATA_DIR=/mnt/instana/cluster
STANCTL_VOLUME_DATA=/mnt/instana/stanctl/data
STANCTL_VOLUME_METRICS=/mnt/instana/stanctl/metrics
STANCTL_VOLUME_ANALYTICS=/mnt/instana/stanctl/analytics
STANCTL_VOLUME_OBJECTS=/mnt/instana/stanctl/objects

# Para perfiles IBM demo/production, confirme con el equipo de storage que
# data, metrics, analytics y objects cumplen aislamiento físico end-to-end.
STORAGE_BACKEND_ISOLATION_CONFIRMED=no

# Confirme también que el storage cumple los IOPS/throughput vigentes de IBM.
STORAGE_PERFORMANCE_CONFIRMED=no
